{
    "/upload/oss": {
        "type": "GET",
        "auth": true,
        "bind": "FileUpload.Oss",
        "content-type": "multipart/form-data",
        "desc": "获取一个30秒的oss上传凭证",
        "request": {
            "type": 1
        }
    },
    "/upload/file": {
        "type": "POST",
        "auth": false,
        "access": 5,
        "limit" : 0,
        "bind": "FileUpload.File",
        "content-type": "multipart/form-data",
        "desc": "上传活动图片资源等"
    },
    "/upload/proxy": {
        "type": "POST",
        "auth": false,
        "async" : true,
        "access": 5,
        "limit" : 0,
        "bind": "FileUpload.Proxy",
        "desc": "上传图片或者json"
    }
}